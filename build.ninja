program_name = syshub-display
tool_todo = addtodo
main = main
mglibc = mglibc
todo = todo

mgsrc = $$MGLIBC_STRINGS
# tcc doesn't have debug info ...
toolchain = clang 
#tcc

rule cc
    command = $toolchain $cflags -MD -MF $out.d -c -o $out $in $includes
    depfile = $out.d
    description = $in

rule link
    command = $toolchain -o $out $in $ldflags

cflags = -g
ldflags = -lm
includes = 

outdir = .build
srcdir = src


###  EXT  ###
build $outdir/libs.o: cc $srcdir/compile_libs.c
    includes = -I$mgsrc

###  OWN  ###
build $outdir/$main.o: cc $srcdir/$main.c
    includes = -I$mgsrc

build $outdir/$todo.o: cc $srcdir/main_todo.c
    includes = -I$mgsrc

build $outdir/$program_name: link $outdir/$main.o $outdir/libs.o
build $outdir/$tool_todo: link $outdir/$todo.o $outdir/libs.o
