program_name = syshub
tool_todo = addtodo
main = syshub
mglibc = mglibc
todo = todo

mgsrc = $$MGLIBC_STRINGS
# tcc doesn't have debug info ...
toolchain = clang 
#tcc

rule cc
    command = $toolchain $cflags -MD -MF $out.d -c -o $out $in $includes
    depfile = $out.d
    description = $in

rule link
    command = $toolchain -o $out $in $ldflags

cflags = -g
ldflags = -lm
includes = 

outdir = .build
srcdir = src


###  EXT  ###
build $outdir/libs.o: cc $srcdir/compile_libs.c
    includes = -I$mgsrc

###  OWN  ###
build $outdir/$main.o: cc $srcdir/main_syshub.c
    includes = -I$mgsrc

build $outdir/$todo.o: cc $srcdir/main_todo.c
    includes = -I$mgsrc

build $outdir/test.o: cc $srcdir/main_test.c
    includes = -I$mgsrc

build $outdir/$main: link $outdir/$main.o $outdir/libs.o
build $outdir/$tool_todo: link $outdir/$todo.o $outdir/libs.o
build $outdir/test: link $outdir/test.o $outdir/libs.o
